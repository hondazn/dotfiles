auto-update-channel = tip
shell-integration-features = ssh-terminfo

font-family = "Moralerspace Krypton HWJPDOC"
font-size = 14.5
#adjust-cell-width = "-7%"
#adjust-cell-height = "-7%"
cursor-invert-fg-bg = true

#font-feature = -calt
#font-feature = -liga
#font-feature = -dlig
# |> == -> =>

# Moralerspace (Monaspace系) のコード用リガチャは ss01–ss10 に入っていて既定で無効
font-feature = ss01
font-feature = ss02
font-feature = ss03
font-feature = ss04
font-feature = ss05
font-feature = ss06
font-feature = ss07
font-feature = ss08
font-feature = ss09
font-feature = ss10

bell-features = audio
bell-audio-path = /System/Library/Sounds/Glass.aiff

confirm-close-surface = false
quit-after-last-window-closed = true

window-height = 60
window-width = 200
# window-position-x = 100
# window-position-y = 180

theme = 0x96f

background-opacity = 0.75
background-blur = 200
# background-opacity-cells = true

link-url = true
link-previews =true

keybind = ctrl+tab=esc:[27;5;9~
keybind = ctrl+shift+tab=esc:[27;6;9~
keybind = shift+enter=text:\x1b\r

custom-shader = ./shaders/cursor_blaze.glsl
custom-shader = ./shaders/cursor_lightning.glsl
custom-shader = ./shaders/sparks.glsl
custom-shader = ./shaders/slash.glsl
custom-shader = ./shaders/gravity.glsl
#custom-shader = ./shaders/cursor_black.glsl
